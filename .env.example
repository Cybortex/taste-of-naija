# ==============================================================================
# TASTE OF NAIJA - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local for local development, or add variables to Vercel
# ==============================================================================

# Public Site Configuration
NEXT_PUBLIC_SITE_URL=https://taste-of-naija.vercel.app
NEXT_PUBLIC_RESTAURANT_NAME="Taste of Naija"
NEXT_PUBLIC_RESTAURANT_PHONE="+234 812 345 6789"
NEXT_PUBLIC_RESTAURANT_WHATSAPP="2348123456789"
NEXT_PUBLIC_RESTAURANT_EMAIL="orders@tasteofnaija.ng"
NEXT_PUBLIC_RESTAURANT_ADDRESS="14 Admiralty Way, Lekki Phase 1, Lagos, Nigeria"

# Convex Backend Configuration (https://convex.dev)
# Set these when deploying to Convex and connecting to Vercel
CONVEX_DEPLOYMENT=dev:taste-of-naija-sample
NEXT_PUBLIC_CONVEX_URL=https://tasteofnaija.convex.cloud

# Payment Gateway (Paystack)
# Public key is used on the client-side for Paystack Inline Popup
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_sample_taste_of_naija_key

# Secret key is used by your backend server / API route to initialize or verify transactions
PAYSTACK_SECRET_KEY=sk_test_sample_taste_of_naija_secret
PAYSTACK_WEBHOOK_SECRET=sk_test_sample_taste_of_naija_secret

# Backend API Configuration
# Point this to your backend server once built (e.g., Express, Nest, FastAPI, or Next.js Route Handlers)
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Database Connection (PostgreSQL, Neon, Supabase, PlanetScale)
DATABASE_URL="postgresql://postgres:password@localhost:5432/taste_of_naija?sslmode=require"
